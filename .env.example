# The canonical site origin, used for auth redirects.
NEXT_PUBLIC_SITE_URL=https://llmtierlist.com

# Cloudflare D1 — accessed via the REST API from the server.
# Token needs the "D1:Edit" permission for the account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# WorkOS AuthKit — https://dashboard.workos.com
# Add {SITE_URL}/auth/callback as a redirect URI in the dashboard.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Random 64-hex-char secret for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=
